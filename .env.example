# Database engine: postgres | mysql | mariadb
DB_TYPE=postgres
DATABASE_URL="PASTE_DATABASE_CONNECTION_URL_HERE"
# Set DB_SSL=false only for local/dev databases without TLS.
DB_SSL=true
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# REST API integration: generate a long random secret (32+ chars).
NEXADB_API_KEY="REPLACE_WITH_LONG_RANDOM_API_KEY"
# Comma-separated tables that external apps may access through /api/v1/data.
# Example: users,bot_tokens,accounts
API_TABLE_ALLOWLIST="bot_tokens,accounts"
